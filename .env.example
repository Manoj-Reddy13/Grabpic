# Azure Storage Configuration
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string_here
AZURE_CONTAINER_NAME=events
USE_BLOB_STORAGE=true

# Security Tokens & Expiration
IMAGE_TOKEN_SECRET=replace_with_a_secure_random_secret_key_in_production
EVENT_EXPIRY_HOURS=10

# Networking & URLs
AI_INTERNAL_BASE_URL=http://localhost:8000
AI_PUBLIC_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8080
